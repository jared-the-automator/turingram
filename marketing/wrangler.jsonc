{
  // The Turingram website, served as static assets from a Cloudflare Worker.
  // Deploy from this directory: `npm run build && npx wrangler deploy`.
  // The site routes with a HashRouter, so every page is index.html plus a
  // fragment, and an unknown path is a real 404.
  // worker.js runs first only to redirect the other hostnames to turingram.com.
  "name": "turingram-site",
  "compatibility_date": "2026-10-06",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "turingram.com", "custom_domain": true },
    { "pattern": "www.turingram.com", "custom_domain": true },
    { "pattern": "turingram.biggerfish.io", "custom_domain": true }
  ]
}
