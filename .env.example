# TEMPLATE ONLY — no values here, ever. This file is tracked by git purely so a
# fresh clone knows WHICH variables to set; real values live in a .env, which is
# gitignored and never committed.
#
# Settings → Provider keys writes this same file, so editing it by hand and
# using the UI are equivalent. The UI shows only whether a key is present.
#
# The app reads, in order (first file to define a key wins):
#   1. <data dir>/.env   — the packaged app. On Linux that is
#                          ~/.config/turingram-workspace/.env, beside meetings.db
#   2. <repo root>/.env  — development
#
#   cp .env.example .env    then fill in .env

# Deepgram — transcription and speaker labels. Nova-3 pre-recorded is $0.26/hr
# with diarization included, and new accounts get $200 of credit (~700 hours)
# that does not expire. https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Google Gemini — meeting summaries. Use a key from a BILLED project: Google's
# terms for the unpaid tier permit human review and model training, and say
# outright not to submit confidential information. https://aistudio.google.com/apikey
GEMINI_API_KEY=
